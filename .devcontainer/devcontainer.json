{
  "name": "Mortality Table Builder",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user uv && uv sync --all-extras",
  "postAttachCommand": "uv run streamlit run app/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/streamlit_app.py"]
    },
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" },
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
